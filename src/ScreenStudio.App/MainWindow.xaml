<Window
    x:Class="ScreenStudio.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Center: placeholder until PostRecordWindow (012) lands -->
        <StackPanel Grid.Row="0" Padding="32" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
            <TextBlock Text="Screen Studio" FontSize="40" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock Text="Recording overlay ready — task #011." Opacity="0.6" HorizontalAlignment="Center"/>
            <Button Content="⚙ Settings" Click="OnSettingsClicked" HorizontalAlignment="Center" Margin="0,12,0,0"/>
        </StackPanel>

        <!-- Bottom: host for the floating recording overlay (constructed in code-behind so its
             compiled x:Bind has a non-null ViewModel root at load time). -->
        <StackPanel Grid.Row="1" x:Name="OverlayHost" HorizontalAlignment="Center" Margin="0,0,0,16"/>
    </Grid>
</Window>
