<UserControl
    x:Class="ScreenStudio.App.Views.RecordingOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
            CornerRadius="32"
            Padding="20,10"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1">
        <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">

            <!-- REC indicator: pulsing red dot when recording, amber when paused -->
            <Ellipse Width="14" Height="14" Fill="{x:Bind RecIndicatorBrush, Mode=OneWay}"/>

            <!-- Live elapsed timer -->
            <TextBlock Text="{x:Bind ViewModel.ElapsedText, Mode=OneWay}"
                       FontFamily="Consolas"
                       FontSize="16"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>

            <!-- Status / state label -->
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                       Opacity="0.7"
                       VerticalAlignment="Center"/>

            <!-- Divider -->
            <Rectangle Width="1" Fill="{ThemeResource ControlElevationBorderBrush}" Margin="0,2"/>

            <!-- Target selector -->
            <ComboBox x:Name="TargetSelector"
                      SelectedIndex="0"
                      SelectionChanged="OnTargetChanged"
                      VerticalAlignment="Center">
                <ComboBoxItem Content="Full Screen"/>
                <ComboBoxItem Content="Display"/>
                <ComboBoxItem Content="Window"/>
                <ComboBoxItem Content="Region"/>
            </ComboBox>

            <!-- Mic / system-audio / webcam toggles -->
            <ToggleSwitch x:Name="MicToggle" Header="Mic" IsOn="True" Toggled="OnMicToggled"/>
            <ToggleSwitch x:Name="AudioToggle" Header="Audio" IsOn="True" Toggled="OnAudioToggled"/>
            <ToggleSwitch x:Name="WebcamToggle" Header="Cam" IsOn="False" Toggled="OnWebcamToggled"/>

            <!-- Divider -->
            <Rectangle Width="1" Fill="{ThemeResource ControlElevationBorderBrush}" Margin="0,2"/>

            <!-- Transport controls: Start / Pause / Resume / Stop -->
            <Button Content="● Record"
                    Style="{StaticResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.StartCommand}"
                    Visibility="{x:Bind ViewModel.ShowStart, Mode=OneWay}"/>
            <Button Content="❚❚ Pause"
                    Command="{x:Bind ViewModel.PauseCommand}"
                    Visibility="{x:Bind ViewModel.ShowPause, Mode=OneWay}"/>
            <Button Content="▶ Resume"
                    Command="{x:Bind ViewModel.ResumeCommand}"
                    Visibility="{x:Bind ViewModel.ShowResume, Mode=OneWay}"/>
            <Button Content="■ Stop"
                    Command="{x:Bind ViewModel.StopCommand}"
                    Visibility="{x:Bind ViewModel.ShowStop, Mode=OneWay}"/>
        </StackPanel>
    </Border>
</UserControl>
