<Window
    x:Class="ScreenStudio.App.Views.PostRecordWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:ScreenStudio.App.Views"
    mc:Ignorable="d"
    Title="Wiggle — Recording">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Main row: preview (left) + style/export panel (right) -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <!-- Left: live preview of the composited (auto-zoomed) recording -->
            <Border Grid.Column="0" CornerRadius="12" Background="Black" Margin="0,0,16,0">
                <Image x:Name="PreviewImage" Stretch="Uniform"/>
            </Border>

            <!-- Right: Style + Export panel -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                    <TextBlock Text="Style" FontSize="20" FontWeight="SemiBold"/>
                    <views:StylePanel x:Name="StyleControls"/>

                    <ToggleSwitch x:Name="EditZoomToggle" Header="Edit zoom" OffContent="Off" OnContent="On"/>

                    <TextBlock Text="Export" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,0"/>
                    <ItemsControl x:Name="PresetChips">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <Expander Header="Custom" IsExpanded="False">
                        <StackPanel Spacing="8">
                            <ComboBox x:Name="CodecBox" Header="Codec" SelectedIndex="0" SelectionChanged="OnCodecChanged">
                                <ComboBoxItem Content="H.264"/>
                                <ComboBoxItem Content="HEVC"/>
                                <ComboBoxItem Content="GIF"/>
                                <ComboBoxItem Content="WebM"/>
                            </ComboBox>
                            <NumberBox x:Name="WidthBox" Header="Width" Value="1920" Minimum="16"/>
                            <NumberBox x:Name="HeightBox" Header="Height" Value="1080" Minimum="16"/>
                            <ComboBox x:Name="FpsBox" Header="Frame rate" SelectedIndex="1">
                                <ComboBoxItem Content="30 fps"/>
                                <ComboBoxItem Content="60 fps"/>
                            </ComboBox>
                            <NumberBox x:Name="BitrateBox" Header="Bitrate (kbps)" Value="12000" Minimum="500"/>
                        </StackPanel>
                    </Expander>
                    <TextBox x:Name="OutputPathBox" Header="Output path" Text="export.mp4"/>
                    <TextBlock x:Name="ValidationText" Foreground="OrangeRed" TextWrapping="Wrap"/>
                    <ProgressBar x:Name="ExportProgress" Visibility="Collapsed" Maximum="1"/>
                    <Button x:Name="ExportButton" Content="Export MP4"
                            Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Stretch" Click="OnExportClicked"/>
                    <TextBlock x:Name="StatusText" Opacity="0.7" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Bottom row: timeline panel (collapsed by default; toggled via Edit zoom) -->
        <views:TimelinePanel x:Name="Timeline" Grid.Row="1" Margin="0,12,0,0" Visibility="Collapsed"/>
    </Grid>
</Window>
